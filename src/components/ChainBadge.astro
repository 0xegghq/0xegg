---
interface Props {
  name: string;
  logo: string;
  color: string;
}

const { name, logo, color } = Astro.props;
---

<span class="chain-badge" style={`--chain-color: ${color}`} title={name}>
  <img src={logo} alt="" aria-hidden="true" width="18" height="18" />
  <span>{name}</span>
</span>

<style>
  .chain-badge {
    --chain-color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 34px;
    padding: 6px 10px 6px 7px;
    border: 1px solid color-mix(in srgb, var(--chain-color) 28%, var(--border));
    border-radius: 999px;
    background: color-mix(in srgb, var(--chain-color) 7%, var(--surface));
    color: var(--muted);
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    transition:
      transform 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease,
      box-shadow 0.15s ease;
  }

  .chain-badge img {
    display: block;
    flex: 0 0 auto;
    border-radius: 5px;
    transition: transform 0.15s ease;
  }

  .chain-badge:hover {
    transform: translateY(-2px);
    border-color: var(--chain-color);
    background: color-mix(in srgb, var(--chain-color) 15%, var(--surface));
    color: var(--text);
    box-shadow: 0 8px 20px color-mix(in srgb, var(--chain-color) 18%, transparent);
  }

  .chain-badge:hover img {
    transform: scale(1.08);
  }
</style>
